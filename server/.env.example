# Copie ce fichier en env/halko.env sur le serveur (chmod 600).
PORT=3000
DATA_DIR=/data
# Généré avec : npm run hash-password -- "ton mot de passe"
APP_PASSWORD_HASH=
# Proxys dont on accepte l'en-tête X-Forwarded-For (le reverse proxy devant l'app)
TRUST_PROXY=127.0.0.1/32,172.16.0.0/12
LOG_LEVEL=info
# Conversion des vidéos et GIF (déjà présents dans l'image Docker)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
